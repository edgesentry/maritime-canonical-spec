{
  "name": "@maritime-ai/canonical-spec",
  "version": "0.0.1",
  "description": "International standards-compliant canonical data model for maritime, port logistics, and marine insurance.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "schemas"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsup",
    "build:schemas": "tsx scripts/build-schemas.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build:schemas && pnpm build"
  },

  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.9",
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^26.6.4",
    "tsup": "^8.4.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
